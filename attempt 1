--Adding Dosage in MG
ALTER TABLE dbo.UKY_RAW_DETAILS_ALL
ADD DOSAGE_IN_MG DECIMAL(18,4);
GO

UPDATE dbo.UKY_RAW_DETAILS_ALL
SET DOSAGE_IN_MG =
CASE
    WHEN ANTIBIOTIC_UNIT_OF_MEASURE = 'mg'
        THEN TRY_CAST(ANTIBIOTIC_DOSE AS DECIMAL(18,4))

    WHEN ANTIBIOTIC_UNIT_OF_MEASURE = 'mcg'
        THEN TRY_CAST(ANTIBIOTIC_DOSE AS DECIMAL(18,4)) / 1000.0

    WHEN ANTIBIOTIC_UNIT_OF_MEASURE = 'g'
        THEN TRY_CAST(ANTIBIOTIC_DOSE AS DECIMAL(18,4)) * 1000.0

    WHEN ANTIBIOTIC_UNIT_OF_MEASURE = 'mg of hydrocodone'
        THEN TRY_CAST(ANTIBIOTIC_DOSE AS DECIMAL(18,4))

    ELSE NULL
END;
