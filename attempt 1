Department Mapping
CREATE TABLE dbo.department_mapping_UKY (
    department NVARCHAR(255),
    departmentid INT
);

INSERT INTO dbo.department_mapping_UKY (department, departmentid)
SELECT
    DEPARTMENT,
    ROW_NUMBER() OVER (ORDER BY DEPARTMENT) + 999 AS departmentid
FROM (
    SELECT DISTINCT DEPARTMENT
    FROM dbo.UKY_RAW_DETAILS_ALL
    WHERE DEPARTMENT IS NOT NULL
) 
