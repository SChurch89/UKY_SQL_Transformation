select 
concat('MER',lk.PrescriptionID) as PrescriptionID,
CONCAT('MER',lk.MaskedVisitID) as EncounterID,
CONCAT('MER',lk.MaskedPatID) as PatientID,
fmm.facilityid as facility,
lk.Gender as Sex,
Age,
case when age between 0 and 10 then '0 to 10'
					 when age between 10 and 20 then '11 to 20'
					 when age between 20 and 30 then '21 to 30'
					 when age between 30 and 40 then '31 to 40'
					 when age between 40 and 50 then '41 to 50'
					 when age between 50 and 60 then '51 to 60'
					 when age between 60 and 70 then '61 to 70'
					 when age between 70 and 80 then '71 to 80'
					 when age >80 then 'Above 80'					 
					 else Null
					 end as 'Age_Range',
case when age>=18 then 'ADULT' when age<18 then 'CHILD' else null end as Age_group,
case when Race is null or race='UNKNOWN' or race='NULL' or race='REFUSED' or race='Unable to respond' then 'Unknown'
					 when race ='AMERICAN INDIAN - ALASKA NATIVE' then 'American Indian or Alaska Native'
					 when race ='MORE THAN ONE RACE' then 'Other'
					 when race ='Native Hawaiian or Other Pacific Islander' or race ='Native Hawaiian' or race= 'Other Pacific Islander' or race='Am Indian/Alask'
					 then 'Native Hawaiian and Other Pacific Islander'
					 when race ='English' then 'White'	
					 when race ='Asian Indian' or race='Filipino' or race='Vietnamese' or race='Korean' or race='Chinese'
					 then 'Asian'
					 else race
					 end as Race,
Null as Ethnicity,
lk.Check_IN_DT as Encounter_Date,
lk.OrderMnemonic as Antibiotic_Raw,
case when lk.GenericDrugName = 'SULFAMETHOXAZOLE/TRIMETHOPRIM' then 'SULFAMETHAZOLE/TRIMETHROPRIM'
					when lk.GenericDrugName = 'AMOXICILLIN/POTASSIUM CLAV' then 'AMOXICILLIN/CLAVULANATE'
					else lk.GenericDrugName
					end as Antibiotic_Name,
'Y' as IsAntibiotic,
lk.strength as Antibiotic_Dose,
case	when am.unit='mg/5ml' then (left(quantity,patindex( '%[^0-9]%', Quantity)-1))*am.dose_mg/5
		when am.unit='mg/10ml' then (left(Quantity,patindex( '%[^0-9]%', Quantity)-1))*am.dose_mg/10
		when am.unit='mg/3ml' then (left(Quantity,patindex( '%[^0-9]%', Quantity)-1))*am.dose_mg/3
		when am.unit='mg/8.4ml' then (left(Quantity,patindex( '%[^0-9]%', Quantity)-1))*am.dose_mg/8.4
		when am.unit='mg/ml' then (left(Quantity,patindex( '%[^0-9]%', Quantity)-1))*am.dose_mg/1
		when am.unit='gram' then (left(Quantity,patindex( '%[^0-9]%', Quantity)-1))*am.dose_mg *1000
		else dose_mg*(left(Quantity,patindex( '%[^0-9]%', Quantity)-1))
		end as total_dose,
null as dose_in_mg,
am.unit antibiotic_unit_of_measure,
(left(quantity,patindex( '%[^0-9]%', Quantity)-1)) as Quantity,
null as Duration,
lk.Frequency as Original_Frequency,
fm.Revised_Frequency as Frequency,
null as Route,
lk.WeightKG as Weight_in_KG,
lk.Enc_Type Encounter_Type,
lk.Payor_Name as Insurance_Type,
'' as Insurance_Name ,
lk.Provider_Type as  Provider_Type,
pm.providerid as Provider_Name,
'' Antibiotic_Allergies,
lk.eGFR as GFR_A,
lk.DrawDT as GFR_A_Date,
null as capsule_based_overall_dose,
case when lk.eGFR<15 then '<15' when lk.eGFR between 15 and 29 then '15-29' when lk.eGFR between 30 and 44 then '30-44' when lk.eGFR between 45 and 59 then '45-59'
when lk.eGFR between 60 and 89 then '60-89' when lk.eGFR >89 then '90 or higher' else null end as GFR_category,
dm.departmentid as Department
-- into CHARM_DETAILS_JAN26
from details_JAN26 lk
left join dose_mapping am on lk.STRENGTH=am.strength
left join Frequency_Mapping fm on fm.Original_Frequency=lk.Frequency
left join provider_mapping pm on lk.provider_name = pm.provider_name
left join facility_mapping fmm on lk.facility = fmm.facility
left join department_mapping dm on lk.department = dm.department


