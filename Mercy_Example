SELECT distinct CC.*,
case when CC.[Drug Choice]='Concordant Drug Choice' and cc.kg_based_min=1 and cc.kg_based_max=1 and 
				(
					(cc.Overall_Dose =cc.Weight_in_KG*cc.[RTR Min])
				 or (cc.Overall_Dose =cc.Weight_in_KG*cc.[RTR Max])
				 or (cc.Overall_Dose between cc.Weight_in_KG*cc.[RTR Min] and cc.Weight_in_KG*cc.[RTR Max])
				)
	 then 'Concordant Dosing'

	 when CC.[Drug Choice]='Concordant Drug Choice' and cc.kg_based_max=0 and cc.kg_based_min=1 and
				(
					(cc.Overall_Dose =cc.Weight_in_KG*cc.[RTR Min]) 
				 or (cc.Overall_Dose =cc.[RTR Max]) 
				 or (cc.Overall_Dose between cc.Weight_in_KG*cc.[RTR Min] and cc.[RTR Max])
				)
	 then 'Concordant Dosing'

	 when CC.[Drug Choice]='Concordant Drug Choice' and cc.kg_based_min=0 and cc.kg_based_max=1 and
				(
					(cc.Overall_Dose =cc.[RTR Max])
				 or (cc.Overall_Dose =cc.Weight_in_KG*cc.[RTR Max])
				 or (cc.Overall_Dose between cc.[RTR Min] and cc.Weight_in_KG*cc.[RTR Max])
				)
	 then 'Concordant Dosing'

	 when CC.[Drug Choice]='Concordant Drug Choice' and cc.kg_based_max =0 and cc.kg_based_min=0 and
				(
					(cc.Overall_Dose =cc.[RTR Min])
				 or (cc.Overall_Dose =cc.[RTR Max])
				 or(cc.Overall_Dose between cc.[RTR Min] and cc.[RTR Max]))
	 then 'Concordant Dosing'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_max=1 and cc.kg_based_min=1 and
		cc.Overall_Dose>cc.Weight_in_KG*cc.[RTR Max]
	 then 'Higher Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_max=0 and cc.kg_based_min=1 and
		cc.Overall_Dose>cc.[RTR Max] 
	 then 'Higher Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_max=1 and cc.kg_based_min=0 and
		cc.Overall_Dose>cc.Weight_in_KG*cc.[RTR Max] 
	 then 'Higher Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_max=0 and cc.kg_based_min=0 and
		Overall_Dose>cc.[RTR Max] 
	 then 'Higher Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_min=1 and cc.kg_based_max=1 and
		cc.Overall_Dose<cc.Weight_in_KG*cc.[RTR Min] 
	 then 'Lower Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_min=0 and cc.kg_based_max=1 and
		cc.Overall_Dose<cc.[RTR Min] 
	 then 'Lower Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_min=1 and cc.kg_based_max=0 and
		cc.Overall_Dose<cc.Weight_in_KG*cc.[RTR Min] 
	 then 'Lower Than Recommended'

	 when CC.[Drug Choice]='Concordant Drug Choice' and  cc.kg_based_max=0 and cc.kg_based_min=0 and
		Overall_Dose<cc.[RTR Min]
	 then 'Lower Than Recommended'

	 else 'Incomplete Information'
	 end as Overall_Dosing_comparision
--into CHARM_CONCORDANCE_JAN26
FROM 
		(

		select distinct 
		sd.PrescriptionID,
		sd.dose_in_mg as Single_Dose,
		sd.dose_in_mg*sd.Duration*sd.Frequency as Overall_Dose,
		sd.capsule_based_overall_dose,		
		sd.dose_in_mg*sd.Frequency as Daily_Dose,
		sd.Age_group,
		sd.Duration,
		case when r.kg_based_max =1 then 'Kg/mg' else 'mg' end as Overall_Dose_Unit,
		case when r.kg_based_max =1 then (dose_in_mg*sd.Duration*sd.Frequency)/Weight_in_KG else dose_in_mg*sd.Duration*sd.Frequency end as Overall_Dose_GauntChart,
		r.Indication as RTR_Indication,
		r.[Rx Name] as RTR_RxName,
		sdg.Diagnosis_Grouping as Diagnosis_Group,
		sd.Antibiotic_Name,
		r.[Min Duration (days)],
		r.[Max Duration (days)],
		r.[RTR Min],
		r.[RTR Max],
		r.[Min Daily Dose (mg)] as Rtr_MinDailyDose,
		r.[Max Daily Dose (mg)] as Rtr_MaxDailyDose,
		r.kg_based_max,
		r.kg_based_min,
		sd.Weight_in_KG,
		--sd.age_group,
		case when sdg.Diagnosis_Grouping= r.indication and sd.Antibiotic_Name=r.[Rx Name] and sd.Age_group=r.[Age Group] then 'Concordant Drug Choice'
			 else 'Discordant Drug Choice'
			 end as 'Drug Choice'
		from CHARM_DETAILS_JAN26 sd 
		inner join CHARM_DIAGNOSIS_JAN26 sdg on sd.EncounterID=sdg.EncounterID 
		left join rtr_general r on sdg.Diagnosis_Grouping= r.Indication and sd.Antibiotic_Name=r.[Rx Name] and r.[Age Group]=sd.age_group
		where sdg.Diagnosis_Grouping in (select distinct Indication from rtr_general)
)CC 
where Antibiotic_Name is not null 
order by cc.[Drug Choice],Overall_Dosing_comparision

