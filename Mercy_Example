--Updates dose_in_mg column in CHARM_DETAILS table for each unique unit of measure value 
UPDATE CHARM_DETAILS_JAN26 
SET dose_in_mg = case when antibiotic_unit_of_measure = 'gram' then total_dose / Quantity
                                                   when antibiotic_unit_of_measure = 'mg/2ml' then (total_dose / Quantity) * 2
                                                   when antibiotic_unit_of_measure = 'mg/3ml' then (total_dose / Quantity) * 3
												   when antibiotic_unit_of_measure = 'mg/4ml' then (total_dose / Quantity) * 4
                                                   when antibiotic_unit_of_measure = 'mg/5ml' then (total_dose / Quantity) * 5
												   when antibiotic_unit_of_measure = 'mg/8.4ml' then (total_dose / Quantity) * 8.4
												   when antibiotic_unit_of_measure = 'mg/10ml' then (total_dose / Quantity) * 10
												   when antibiotic_unit_of_measure = 'mg/ml' then total_dose / Quantity
												   when antibiotic_unit_of_measure = 'mg/mL' then total_dose / Quantity
												   when antibiotic_unit_of_measure = 'mg' then total_dose / Quantity
												   when antibiotic_unit_of_measure = 'mg-' then total_dose / Quantity
												   else NULL end

--Updates Duration column in CHARM_DETAILS table for each unique unit of measure value
UPDATE CHARM_DETAILS_JAN26
SET Duration = case when antibiotic_unit_of_measure = 'gram' then Quantity / Frequency
                                                 when antibiotic_unit_of_measure = 'mg' then Quantity / Frequency
                                                 when antibiotic_unit_of_measure = 'mg/2ml' then Quantity / (Frequency * 2)
												 when antibiotic_unit_of_measure = 'mg/3ml' then Quantity / (Frequency * 3)
												 when antibiotic_unit_of_measure = 'mg/4ml' then Quantity / (Frequency * 4)
												 when antibiotic_unit_of_measure = 'mg/5ml' then Quantity / (Frequency * 5)
												 when antibiotic_unit_of_measure = 'mg/8.4ml' then Quantity / (Frequency * 8.4)
												 when antibiotic_unit_of_measure = 'mg/10ml' then Quantity / (Frequency * 10)
												 when antibiotic_unit_of_measure = 'mg/ml' then Quantity / Frequency
												 when antibiotic_unit_of_measure = 'mg/mL' then Quantity / Frequency
												 when antibiotic_unit_of_measure = 'mg-' then Quantity / Frequency
												 else NULL end

