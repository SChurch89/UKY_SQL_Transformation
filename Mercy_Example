		r.[Min Daily Dose (mg)] as Rtr_MinDailyDose,
		r.[Max Daily Dose (mg)] as Rtr_MaxDailyDose,
		r.kg_based_max,
		r.kg_based_min,
		sd.Weight_in_KG,
		--sd.age_group,
		case when sdg.Diagnosis_RTR= r.indication and sd.Antibiotic_Name=r.[Rx Name] and sd.Age_group=r.[Age Group] then 'Concordant Drug Choice'
			 else 'Discordant Drug Choice'
			 end as 'Drug Choice'
		from CHARM_DETAILS_JAN26 sd 
		inner join CHARM_DiAGNOSIS_JAN26 sdg on sd.EncounterID=sdg.EncounterID 
		left join rtr_mercy r on sdg.Diagnosis_RTR= r.Indication and sd.Antibiotic_Name=r.[Rx Name] and r.[Age Group]=sd.age_group
		where sdg.Diagnosis_RTR in (select distinct Indication from rtr_mercy)
)CC 
where Antibiotic_Name is not null 
order by cc.[Drug Choice],Overall_Dosing_comparision

